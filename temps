[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://bitbucket.org/williamrandev/autoprospectionadmin.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "deborah"]
	remote = origin
	merge = refs/heads/deborah
	vscode-merge-base = origin/main
[branch "diary-branch"]
	vscode-merge-base = origin/deborah